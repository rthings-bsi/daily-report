generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

model Gudang {
  gudangId  Int      @id // 1..14
  name      String   // "Gudang 1"
  prefix    String   // "5A".."5N"
  active    Boolean  @default(true)
  users     User[]
  sessions  ReportSession[]
  settings  GudangSetting[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GudangSetting {
  settingId String   @id @default(cuid())
  gudangId  Int
  key       String   // "mvt_overrides" | "mvt_disabled" | "wc_custom" | "wc_disabled" | "sloc_exit" | "penampungan" | "capacity"
  value     String   // JSON-encoded
  gudang    Gudang   @relation(fields: [gudangId], references: [gudangId], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([gudangId, key])
  @@index([gudangId])
}

model User {
  userId    String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("user") // "admin" | "user"
  gudangId  Int?     // null = admin (cross-tenant access)
  gudang    Gudang?  @relation(fields: [gudangId], references: [gudangId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gudangId])
}

model ReportSession {
  reportSessionId   String     @id @default(cuid())
  gudangId          Int?       // null = legacy/unscoped; admin still sees these
  gudang            Gudang?    @relation(fields: [gudangId], references: [gudangId])
  label             String
  dateStr           String
  fileName          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  movements         Movement[]              @relation("MovementToSession")   // Legacy — existing sessions
  movementSummaries MovementSummary[]       @relation("MovementSummaryToSession") // Aggregated (new saves)
  stocks            Stock[]                 @relation("StockToSession")           // Legacy — existing sessions
  stockSummaries    StockSummary[]          @relation("StockSummaryToSession")   // Aggregated (new saves)
  stockCards        String?
  stats             String?                 // JSON: pre-calculated KPI
  rawMovements      String?                 // JSON: raw rows for detail table / gudang filter
  rawStocks         String?                 // JSON: raw stock rows (new saves, replaces Stock rows)

  @@index([gudangId])
}

model Movement {
  movementId        String        @id @default(cuid())
  reportSessionId   String
  postingDate       DateTime
  dateStr           String
  moveType          String
  description       String
  workCenter        String?
  batch             String?
  storageLocation   String?
  quantity          Float
  unitQuantity      Float
  group             String
  color             String
  userName          String?
  reportSession     ReportSession @relation("MovementToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([reportSessionId])
}

model MovementSummary {
  movementSummaryId String        @id @default(cuid())
  reportSessionId   String
  dateStr           String
  moveType          String
  description       String
  workCenter        String?
  group             String
  color             String
  totalQuantity     Float
  totalUnitQuantity Float
  totalCount        Int
  reportSession     ReportSession @relation("MovementSummaryToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([reportSessionId])
  @@index([reportSessionId, group])
  @@index([reportSessionId, dateStr])
  @@index([reportSessionId, moveType])
  @@index([reportSessionId, workCenter])
  @@index([dateStr])
  @@index([dateStr, group])
}

model StockSummary {
  stockSummaryId   String        @id @default(cuid())
  reportSessionId  String
  sloc             String?
  status           String        // "Fast Moving" | "Slow Moving" | "Sloc Penampungan" | "Unknown"
  totalUnitQty     Float
  totalWeight      Float         // KG (display layer divides by 1000 for ton)
  itemCount        Int
  reportSession    ReportSession @relation("StockSummaryToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([reportSessionId])
  @@index([reportSessionId, sloc])
}

model Stock {
  stockId          String        @id @default(cuid())
  reportSessionId  String
  material         String
  description      String
  batch            String?
  sloc             String?
  category         String?
  unitQty          Float
  weight           Float
  reportSession    ReportSession @relation("StockToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([reportSessionId])
  @@index([reportSessionId, sloc])
}
