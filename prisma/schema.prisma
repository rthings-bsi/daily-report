generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Gudang {
  gudangId  Int             @id
  name      String
  prefix    String
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  settings  GudangSetting[]
  sessions  ReportSession[]
  users     User[]
  auditSessions AuditSlocSession[]
}

model GudangSetting {
  settingId String   @id @default(cuid())
  gudangId  Int
  key       String
  value     String
  updatedAt DateTime @updatedAt
  gudang    Gudang   @relation(fields: [gudangId], references: [gudangId], onDelete: Cascade)

  @@unique([gudangId, key])
  @@index([gudangId])
}

model User {
  username  String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  gudangId  Int?
  updatedAt DateTime @updatedAt
  userId    String   @id @default(cuid())
  gudang    Gudang?  @relation(fields: [gudangId], references: [gudangId])

  @@index([gudangId])
}

model ReportSession {
  label             String
  dateStr           String
  fileName          String?
  createdAt         DateTime          @default(now())
  gudangId          Int?
  rawMovements      String?
  rawStocks         String?
  reportSessionId   String            @id @default(cuid())
  stats             String?
  stockCards        String?
  updatedAt         DateTime          @updatedAt
  movements         Movement[]        @relation("MovementToSession")
  movementSummaries MovementSummary[] @relation("MovementSummaryToSession")
  gudang            Gudang?           @relation(fields: [gudangId], references: [gudangId])
  stocks            Stock[]           @relation("StockToSession")
  stockSummaries    StockSummary[]    @relation("StockSummaryToSession")

  @@index([gudangId])
  @@index([dateStr])
  @@index([dateStr, gudangId])
}

model Movement {
  postingDate     DateTime
  dateStr         String
  moveType        String
  description     String
  workCenter      String?
  batch           String?
  storageLocation String?
  quantity        Float
  unitQuantity    Float
  group           String
  color           String
  userName        String?
  createdAt       DateTime      @default(now())
  movementId      String        @id @default(cuid())
  reportSessionId String
  updatedAt       DateTime      @updatedAt
  reportSession   ReportSession @relation("MovementToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)

  @@index([reportSessionId])
}

model MovementSummary {
  movementSummaryId String        @id @default(cuid())
  reportSessionId   String
  dateStr           String
  moveType          String
  description       String
  workCenter        String?
  group             String
  color             String
  totalQuantity     Float
  totalUnitQuantity Float
  totalCount        Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reportSession     ReportSession @relation("MovementSummaryToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)

  @@index([reportSessionId])
  @@index([reportSessionId, group])
  @@index([reportSessionId, dateStr])
  @@index([reportSessionId, moveType])
  @@index([reportSessionId, workCenter])
  @@index([dateStr])
  @@index([dateStr, group])
}

model StockSummary {
  stockSummaryId  String        @id @default(cuid())
  reportSessionId String
  sloc            String?
  status          String
  totalUnitQty    Float
  totalWeight     Float
  itemCount       Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reportSession   ReportSession @relation("StockSummaryToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)

  @@index([reportSessionId])
  @@index([reportSessionId, sloc])
}

model Stock {
  material        String
  description     String
  batch           String?
  sloc            String?
  category        String?
  unitQty         Float
  weight          Float
  createdAt       DateTime      @default(now())
  reportSessionId String
  stockId         String        @id @default(cuid())
  updatedAt       DateTime      @updatedAt
  reportSession   ReportSession @relation("StockToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)

  @@index([reportSessionId])
  @@index([reportSessionId, sloc])
}

model AuditSlocSession {
  id            String          @id @default(cuid())
  title         String
  dateStr       String
  plant         String?
  gudangId      Int?
  fileName      String?
  totalItems    Int             @default(0)
  totalQtySap   Float           @default(0)
  totalKgSap    Float           @default(0)
  totalQtyAudit Float           @default(0)
  totalKgAudit  Float           @default(0)
  totalDiffQty  Float           @default(0)
  totalDiffKg   Float           @default(0)
  matchCount    Int             @default(0)
  diffCount     Int             @default(0)
  rawJson       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  gudang        Gudang?         @relation(fields: [gudangId], references: [gudangId])
  items         AuditSlocItem[]

  @@index([gudangId])
  @@index([dateStr])
}

model AuditSlocItem {
  id          String           @id @default(cuid())
  sessionId   String
  plant       String
  sloc        String
  material    String
  batch       String?
  sapQty      Float            @default(0)
  eomKg       Float            @default(0)
  qtyAudit    Float            @default(0)
  kgAudit     Float            @default(0)
  diffKgAudit Float            @default(0)
  diffQty     Float            @default(0)
  sapRef      Float?
  actual      Float?
  diffAudit   Float?
  status      String           @default("MATCH")
  createdAt   DateTime         @default(now())
  session     AuditSlocSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sloc])
  @@index([material])
  @@index([status])
}

model RoleConfig {
  id          String   @id @default(cuid())
  roleId      String   @unique
  name        String
  description String?
  color       String?  @default("bg-slate-500")
  isSystem    Boolean  @default(false)
  scope       String   @default("gudang") // "global" | "gudang"
  permissions String   @default("[]") // JSON string of module keys
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
