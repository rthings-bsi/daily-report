generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Gudang {
  gudangId  Int             @id
  name      String
  prefix    String
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  settings  GudangSetting[]
  sessions  ReportSession[]
  users     User[]
}

model GudangSetting {
  settingId String   @id @default(cuid())
  gudangId  Int
  key       String
  value     String
  updatedAt DateTime @updatedAt
  gudang    Gudang   @relation(fields: [gudangId], references: [gudangId], onDelete: Cascade)

  @@unique([gudangId, key])
  @@index([gudangId])
}

model User {
  username  String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  gudangId  Int?
  updatedAt DateTime @updatedAt
  userId    String   @id @default(cuid())
  gudang    Gudang?  @relation(fields: [gudangId], references: [gudangId])

  @@index([gudangId])
}

model ReportSession {
  label             String
  dateStr           String
  fileName          String?
  createdAt         DateTime          @default(now())
  gudangId          Int?
  rawMovements      String?
  rawStocks         String?
  reportSessionId   String            @id @default(cuid())
  stats             String?
  stockCards        String?
  updatedAt         DateTime          @updatedAt
  movements         Movement[]        @relation("MovementToSession")
  movementSummaries MovementSummary[] @relation("MovementSummaryToSession")
  gudang            Gudang?           @relation(fields: [gudangId], references: [gudangId])
  stocks            Stock[]           @relation("StockToSession")
  stockSummaries    StockSummary[]    @relation("StockSummaryToSession")

  @@index([gudangId])
}

model Movement {
  postingDate     DateTime
  dateStr         String
  moveType        String
  description     String
  workCenter      String?
  batch           String?
  storageLocation String?
  quantity        Float
  unitQuantity    Float
  group           String
  color           String
  userName        String?
  createdAt       DateTime      @default(now())
  movementId      String        @id @default(cuid())
  reportSessionId String
  updatedAt       DateTime      @updatedAt
  reportSession   ReportSession @relation("MovementToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)

  @@index([reportSessionId])
}

model MovementSummary {
  movementSummaryId String        @id @default(cuid())
  reportSessionId   String
  dateStr           String
  moveType          String
  description       String
  workCenter        String?
  group             String
  color             String
  totalQuantity     Float
  totalUnitQuantity Float
  totalCount        Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reportSession     ReportSession @relation("MovementSummaryToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)

  @@index([reportSessionId])
  @@index([reportSessionId, group])
  @@index([reportSessionId, dateStr])
  @@index([reportSessionId, moveType])
  @@index([reportSessionId, workCenter])
  @@index([dateStr])
  @@index([dateStr, group])
}

model StockSummary {
  stockSummaryId  String        @id @default(cuid())
  reportSessionId String
  sloc            String?
  status          String
  totalUnitQty    Float
  totalWeight     Float
  itemCount       Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reportSession   ReportSession @relation("StockSummaryToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)

  @@index([reportSessionId])
  @@index([reportSessionId, sloc])
}

model Stock {
  material        String
  description     String
  batch           String?
  sloc            String?
  category        String?
  unitQty         Float
  weight          Float
  createdAt       DateTime      @default(now())
  reportSessionId String
  stockId         String        @id @default(cuid())
  updatedAt       DateTime      @updatedAt
  reportSession   ReportSession @relation("StockToSession", fields: [reportSessionId], references: [reportSessionId], onDelete: Cascade)

  @@index([reportSessionId])
  @@index([reportSessionId, sloc])
}
