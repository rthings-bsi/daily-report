generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model ReportSession {
  id           String     @id @default(cuid())
  label        String
  dateStr      String
  fileName     String?
  createdAt    DateTime   @default(now())
  movements    Movement[]              // Legacy — existing sessions
  movementSummaries MovementSummary[]  // Aggregated (new saves)
  stocks       Stock[]
  stockCards   String?
  stats        String?                 // JSON: pre-calculated KPI
  rawMovements String?                 // JSON: raw rows for detail table / gudang filter
  rawStocks    String?                 // JSON: raw stock rows (new saves, replaces Stock rows)
}

model Movement {
  id               String        @id @default(cuid())
  sessionId        String
  postingDate      DateTime
  dateStr          String
  moveType         String
  description      String
  workCenter       String?
  batch            String?
  storageLocation  String?
  quantity         Float
  unitQuantity     Float
  group            String
  color            String
  userName         String?
  session          ReportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model MovementSummary {
  id                String        @id @default(cuid())
  sessionId         String
  dateStr           String
  moveType          String
  description       String
  workCenter        String?
  group             String
  color             String
  totalQuantity     Float
  totalUnitQuantity Float
  totalCount        Int
  session           ReportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, group])
  @@index([sessionId, dateStr])
  @@index([sessionId, moveType])
  @@index([sessionId, workCenter])
}

model Stock {
  id          String        @id @default(cuid())
  sessionId   String
  material    String
  description String
  batch       String?
  sloc        String?
  category    String?
  unitQty     Float
  weight      Float
  session     ReportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, sloc])
}
